# ── Site ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=
# Deixe 1 só quando o conteúdo passar pela revisão jurídica e for para indexar no Google.
SITE_INDEXABLE=

# ── Supabase (projeto escolhido pelo Alex; ver docs/DECISIONS.md) ───────────
NEXT_PUBLIC_SUPABASE_URL=
# Chave publicável (sb_publishable_…) ou anon key legada, conforme o projeto.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor. Nunca com prefixo NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres pelo pooler (modo transação, porta 6543), usuário rtb_app.<ref> (ver README › Banco).
DATABASE_URL=
DATABASE_SSL=require

# ── Login e arquivos ─────────────────────────────────
# supabase (produção) | local (só desenvolvimento; recusado na Vercel)
AUTH_DRIVER=supabase
LOCAL_AUTH_SECRET=
# supabase | local
STORAGE_DRIVER=supabase

# ── E-mail (Resend) ──────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Segredo do webhook do Resend (whsec_…), para confirmar entrega.
RESEND_WEBHOOK_SECRET=

# ── Rotinas ──────────────────────────────────────────
CRON_SECRET=

# ── Busca de CEP (não precisa de chave) ──────────────
# live: ViaCEP → BrasilAPI → OpenCEP, pelo servidor | fixture: CEPs fixos, só para testes (exige AUTH_DRIVER=local)
CEP_DRIVER=live

# ── Running (não existe integração; adaptador desligado) ─
RUNNING_INTEGRATION_ENABLED=false
RUNNING_API_BASE_URL=
RUNNING_API_TOKEN=

# ── Analytics próprio com consentimento ──────────────
NEXT_PUBLIC_ANALYTICS_ENABLED=false
