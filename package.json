{
  "name": "bora-road-to-boston-2028",
  "version": "0.1.0",
  "private": true,
  "description": "BORA Road to Boston 2028: landing, Boston Passport (PWA) e BORA OS do projeto. Iniciativa independente da BORA.",
  "scripts": {
    "dev": "next dev -p 3530",
    "build": "next build",
    "start": "next start -p 3530",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:start": "node scripts/db/local.mjs start",
    "db:reset": "node scripts/db/local.mjs reset",
    "db:stop": "node scripts/db/local.mjs stop",
    "db:status": "node scripts/db/local.mjs status",
    "db:types": "node scripts/db/gen-types.mjs",
    "test": "playwright test",
    "test:unit": "playwright test --project=unit",
    "test:db": "playwright test --project=db",
    "test:e2e": "playwright test --project=e2e-iphone --project=e2e-desktop",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run test:db && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@gsap/react": "2.1.2",
    "@hookform/resolvers": "^7.0.8",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "clsx": "^2.1.1",
    "gsap": "3.15.1",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "next": "^16.4.6",
    "postgres": "^3.4.9",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "recharts": "^3.11.0",
    "server-only": "^0.0.1",
    "uqr": "^0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "17.12.0-beta.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  }
